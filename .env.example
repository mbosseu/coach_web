NODE_ENV=development
HOST=127.0.0.1
# Enable only behind a local proxy that overwrites X-Real-IP.
TRUST_LOOPBACK_PROXY=false
PORT=4173
APP_ORIGIN=http://127.0.0.1:4173
DATABASE_PATH=./data/boxing-center.sqlite
DB_PROVIDER=sqlite
# Vercel: DB_PROVIDER=supabase and Connect > Transaction pooler (port 6543).
# Private PostgreSQL connection string; never an anon/service_role browser key.
# Local overlay (gitignored): copy these into .env.supabase.local for migration/checks.
SUPABASE_DATABASE_URL=
SUPABASE_PROJECT_REF=
# Optional PEM CA from the Supabase dashboard, with escaped newlines.
SUPABASE_DB_CA=
CRON_SECRET=
# True only after a secure once-per-minute mail retry scheduler is configured.
MAIL_SCHEDULER_READY=false
BACKUP_DIR=./backups
# Use brevo only after configuring the active key and verified sender server-side.
MAIL_MODE=disabled
REGISTRATION_APPROVAL=true
# Only set true after the direction validates all six schedules, season and exceptions.
SCHEDULES_CONFIRMED=false
BREVO_API_KEY=
BREVO_KEY_EXPOSED=false
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Boxing Center
BREVO_REPLY_TO=boxingcenter31@gmail.com
# Optional: absolute path to the existing boutique .env (not its example file).
# BREVO_ENV_FILE=
